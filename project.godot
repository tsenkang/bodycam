; Engine configuration file.
; Projeto: Bodycam FPS (protótipo)

config_version=5

[application]

config/name="Bodycam FPS Prototype"
config/description="Protótipo de FPS original com câmera estilo bodycam."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameConfig="*res://config/game_config.gd"
Events="*res://core/events.gd"
AudioManager="*res://core/audio_manager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Bots"
3d_physics/layer_4="Hitboxes"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=2048
